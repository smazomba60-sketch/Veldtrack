direction: right

J1: "J1\n9–24 VDC BENCH IN" {
  shape: rectangle
  style.fill: "#E8F1FF"
}
F1: "F1\n2 A PTC" {shape: rectangle}
Q1: "Q1\nP-MOS reverse polarity" {shape: rectangle}
D1: "D1\nSMBJ24A TVS\nVIN_PROT+ to GND" {shape: rectangle}
U1: "U1\nBuck 9–24 V → 5.10 V\n≥3 A rated" {shape: rectangle}
D2: "D2\n5 V TVS" {shape: rectangle}
Cbulk: "C1 + C2\n100 µF + 100 nF" {shape: rectangle}
Q2: "Q2\nP-MOS high-side cutoff\nKILL_EN: LOW = OFF" {shape: rectangle}
Rshunt: "RSHUNT\n50 mΩ / 2 W / 1%\nKelvin sense" {shape: rectangle}
J2: "J2\nPROTECTED DUT POWER\n5 V nominal" {shape: rectangle}

Q3: "Q3\n2N7002 gate pull-down" {shape: rectangle}
Q4: "Q4\nN-MOS load switch\nLOAD_EN/PWM" {shape: rectangle}
Rload: "RLOAD\n4.7 Ω / 10 W\nshort pulse only" {shape: rectangle}

J3: "J3 CONTROL\nKILL_EN\nLOAD_EN/PWM\nGND\nVMON\nISENSE" {shape: rectangle}
J4: "J4 MEASURE\nVIN_RAW\nVIN_PROT\nVBUCK\nV_DUT\nISENSE+/-\nGND" {shape: rectangle}

GND: "COMMON GND" {shape: rectangle}

J1 -> F1: "VIN_RAW+"
F1 -> Q1: "VIN_FUSED+"
Q1 -> U1: "VIN_PROT+"
Q1 -> D1: "protected input clamp"
D1 -> GND
U1 -> D2: "VBUCK+ 5.10 V"
U1 -> Cbulk: "bulk + HF bypass"
D2 -> GND
Cbulk -> GND
D2 -> Q2: "pre-cutoff rail"
Q2 -> Rshunt: "VSW+"
Rshunt -> J2: "V_DUT+"
J2 -> GND

J3 -> Q3: "KILL_EN"
Q3 -> Q2: "gate drive"
J3 -> Q4: "LOAD_EN/PWM"
Q4 -> Rload: "low-side switched sink"
Rload -> J2: "V_DUT+"
Q4 -> GND

J4 -> J1: "monitor VIN_RAW+"
J4 -> Q1: "monitor VIN_PROT+"
J4 -> U1: "monitor VBUCK+"
J4 -> Rshunt: "TP_IS+ / TP_IS-"
J4 -> J2: "monitor V_DUT+"
J4 -> GND
J3 -> GND: "logic return"

Note: "SAFETY: 5 V low-voltage fixture only.\nUse current limiting, fuse, guarded terminals, and verify DUT rating before power.\nSee docs/HIL_POWER_FAULT_FIXTURE.md for netlist, BOM, bring-up, and acceptance checks." {
  shape: rectangle
  style.fill: "#FFF4CC"
}
